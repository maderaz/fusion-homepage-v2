---
import { Image } from "astro:assets";
import BaseLayout from "@/shared/layouts/base-layout.astro";
import Nav from "../components/nav.astro";
import Footer from "@/shared/components/footer.astro";
import CookieBanner from "@/shared/components/cookie-banner.astro";
import vaultOverview from "@/shared/assets/vault-overview.png";
---

<BaseLayout
  title="Fusion by IPOR | Onchain Vault Infrastructure"
  description="Build your own institutional-grade yield strategies or explore existing ones via the Fusion App."
>
  <Nav />
  <main class="overflow-x-hidden bg-[#ECE9F7] text-black">
    <!-- Hero section -->
    <section class="mx-auto max-w-[1200px] px-6 pt-28 pb-20 md:pt-36 md:pb-28">
      <h1 class="text-4xl font-medium md:text-5xl lg:text-6xl leading-[1.25]">
        Meet Fusion
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted-foreground">
        Build your own institutional-grade yield strategies or explore existing
        ones via the Fusion App.
      </p>

      <!-- Two cards -->
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <!-- Card 1: Discover Fusion -->
        <div
          class="rounded-[18px] border p-9 transition-colors border-border bg-card flex flex-col min-h-[420px]"
        >
          <div class="mb-6 flex items-center gap-3">
            <img
              src="/brand/full-logo/fusion-full-logo-black-text.svg"
              alt="Fusion by IPOR"
              class="h-9 w-auto"
              width="118"
              height="36"
            />
          </div>
          <h2 class="text-2xl font-medium tracking-tight md:text-3xl">
            Vault infrastructure for
            <span
              class="bg-gradient-to-r from-brand-gradient-start to-brand-gradient-end bg-clip-text text-transparent"
              >institutional-grade</span
            >
            yield.
          </h2>
          <p class="mt-4 text-muted-foreground">
            Create and manage onchain vaults within a battle-tested risk
            framework.
          </p>
          <div class="mt-auto pt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="https://fusion.ipor.io"
              class="brand-gradient inline-flex items-center justify-center gap-2 rounded-full border border-primary px-6 py-2.5 text-sm font-semibold text-white transition-opacity duration-300 hover:opacity-70"
            >
              Discover Fusion
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 7h10v10"></path>
                <path d="M7 17 17 7"></path>
              </svg>
            </a>
            <span class="text-sm text-[#D3D0D0]">fusion.ipor.io</span>
          </div>
        </div>

        <!-- Card 2: The Live App -->
        <div
          class="relative rounded-[18px] border overflow-hidden transition-colors border-border bg-card md:min-h-[420px]"
        >
          <div class="p-9 flex flex-col md:h-full">
            <div class="mb-6 flex items-center gap-3">
              <img
                src="/brand/full-logo/fusion-full-logo-black-text.svg"
                alt="Fusion by IPOR"
                class="h-9 w-auto"
                width="118"
                height="36"
              />
            </div>
            <h2 class="text-2xl font-medium tracking-tight md:text-3xl">
              The <span
                class="bg-gradient-to-r from-brand-gradient-start to-brand-gradient-end bg-clip-text text-transparent"
                >Live</span
              > App
            </h2>
            <p class="mt-4 mb-8 text-muted-foreground">
              Discover existing yield<br />
              strategies powered by Fusion.<br />
              Get started in one-click.
            </p>
            <a
              href="https://app.ipor.io/fusion"
              target="_blank"
              rel="noopener noreferrer"
              class="mt-auto self-start brand-gradient inline-flex items-center justify-center gap-2 rounded-full border border-primary px-6 py-2.5 text-sm font-semibold text-white transition-opacity duration-300 hover:opacity-70"
            >
              Launch App
            </a>
          </div>
          <Image
            src={vaultOverview}
            alt="Fusion App"
            class="w-full rounded-lg md:absolute md:bottom-0 md:right-0 md:w-[45%] md:rounded-tl-[17px] md:rounded-bl-[17px] md:rounded-br-[17px] md:rounded-tr-none object-cover"
            width={560}
            densities={[1, 2]}
          />
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <CookieBanner />
</BaseLayout>
