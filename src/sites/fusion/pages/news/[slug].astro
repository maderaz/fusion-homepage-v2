---
import BaseLayout from "@/shared/layouts/base-layout.astro";
import Nav from "../../components/nav.astro";
import Footer from "@/shared/components/footer.astro";
import CookieBanner from "@/shared/components/cookie-banner.astro";
import ArticleCard from "../../components/article-card.astro";
import RichText from "../../components/rich-text.astro";
import { getArticles, formatDate } from "../../data/articles";
import type { Article } from "../../data/articles";

export function getStaticPaths() {
  return getArticles().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const more = getArticles()
  .filter((a) => a.slug !== article.slug)
  .slice(0, 2);

const canonicalURL = new URL(`/news/${article.slug}`, Astro.site);
const shareText = encodeURIComponent(article.title);
const shareUrl = encodeURIComponent(canonicalURL.toString());
const xShare = `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`;
const liShare = `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`;

const author = article.author;

// Structured data: establishes IPOR as author/publisher of this content and
// declares the canonical URL and original publish date.
const imageAbs = new URL(article.coverImage ?? "/brand/bitgo-announcement.png", Astro.site).toString();
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.seoDescription ?? article.excerpt,
  image: [imageAbs],
  datePublished: article.date,
  dateModified: article.date,
  inLanguage: "en",
  author: {
    "@type": "Organization",
    name: author.name,
    url: new URL("/", Astro.site).toString(),
  },
  publisher: {
    "@type": "Organization",
    name: "IPOR Labs",
    logo: {
      "@type": "ImageObject",
      url: new URL("/icons/fusion-light.png", Astro.site).toString(),
    },
    sameAs: ["https://x.com/ipor_io", "https://docs.ipor.io/"],
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL.toString() },
  url: canonicalURL.toString(),
});
---

<BaseLayout
  title={`${article.seoTitle ?? article.title} | Fusion`}
  description={article.seoDescription ?? article.excerpt}
  image={article.coverImage}
  imageWidth={article.coverImage ? 1200 : undefined}
  imageHeight={article.coverImage ? 480 : undefined}
  ogType="article"
  publishedTime={article.date}
  modifiedTime={article.date}
>
  <script type="application/ld+json" set:html={jsonLd} />

  <Nav />
  <div class="min-h-screen bg-background">
    <!-- Ambient brand glow behind the header -->
    <div class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-[420px] opacity-70 dark:opacity-100"
        style="background: radial-gradient(ellipse 60% 70% at 50% -10%, var(--color-secondary) 0%, transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <article class="relative mx-auto max-w-[760px] px-4 pt-32 pb-16 sm:px-6 md:pt-40">
        <!-- Back link -->
        <a
          href="/news"
          class="mb-8 inline-flex items-center gap-2 text-[14px] text-muted-foreground transition-colors hover:text-foreground"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 19-7-7 7-7"></path>
            <path d="M19 12H5"></path>
          </svg>
          All Ecosystem News
        </a>

        {article.coverImage && (
          <img
            src={article.coverImage}
            alt={article.title}
            width="1200"
            height="480"
            decoding="async"
            class="mb-8 w-full rounded-2xl border border-border object-cover"
            style="aspect-ratio: 5 / 2;"
          />
        )}

        <!-- Header -->
        <header class="mb-10">
          <div class="mb-5 flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="inline-flex items-center rounded-full bg-secondary px-3 py-1 text-[11px] font-medium uppercase tracking-wide text-secondary-foreground">
              {article.category}
            </span>
            <time datetime={article.date} class="text-[13px] text-muted-foreground">
              {formatDate(article.date)}
            </time>
            <span class="text-[13px] text-muted-foreground/60">
              &middot; {article.readingMinutes} min read
            </span>
          </div>

          <h1
            class="text-balance font-medium text-foreground"
            style="font-size: clamp(20px, 3.5vw, 31px); line-height: 1.2;"
          >
            {article.title}
          </h1>

          <!-- Byline + share -->
          <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-y border-border py-4">
            <div class="flex items-center gap-3">
              <img src="/brand/fusion-pfp.jpg" alt={author.name} width="36" height="36" loading="lazy" decoding="async" class="h-9 w-9 rounded-full object-cover ring-1 ring-border" />
              <span class="text-[14px] font-medium text-foreground">{author.name}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="mr-1 hidden text-[13px] text-muted-foreground sm:inline">Share</span>
              <a href={xShare} target="_blank" rel="noopener" aria-label="Share on X" class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-primary/40 hover:text-primary">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817-5.966 6.817H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
              </a>
              <a href={liShare} target="_blank" rel="noopener" aria-label="Share on LinkedIn" class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-primary/40 hover:text-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
              </a>
              <button
                type="button"
                data-copy-link
                data-url={canonicalURL.toString()}
                aria-label="Copy link"
                class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-primary/40 hover:text-primary"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
              </button>
            </div>
          </div>
        </header>

        <!-- Body -->
        <div class="flex flex-col">
          {article.body.map((block) => {
            if (block.type === "lead") {
              return (
                <p class="mb-7 text-[16px] font-normal text-foreground" style="line-height: 1.7;">
                  <RichText text={block.text} />
                </p>
              );
            }
            if (block.type === "paragraph") {
              return (
                <p class="mb-6 text-[16px] text-body-foreground" style="line-height: 1.8;">
                  <RichText text={block.text} />
                </p>
              );
            }
            if (block.type === "heading") {
              return (
                <h2 class="mb-3 mt-6 text-[22px] font-medium text-foreground md:text-[26px]">
                  {block.text}
                </h2>
              );
            }
            if (block.type === "list") {
              return (
                <ul class="mb-6 flex flex-col gap-2.5 pl-1">
                  {block.items.map((item) => (
                    <li class="flex gap-3 text-[16px] text-body-foreground" style="line-height: 1.7;">
                      <span class="mt-[10px] h-1.5 w-1.5 shrink-0 rounded-full bg-primary/60" aria-hidden="true"></span>
                      <span><RichText text={item} /></span>
                    </li>
                  ))}
                </ul>
              );
            }
            if (block.type === "source") {
              return (
                <a href={block.url} target="_blank" rel="noopener noreferrer"
                  class="group mb-7 flex items-start gap-3 rounded-xl border border-border bg-card px-4 py-3.5 transition-colors hover:border-primary/40">
                  <svg class="mt-0.5 shrink-0 text-primary" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                  <span class="flex flex-col">
                    <span class="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">Source</span>
                    <span class="text-[14px] font-medium text-foreground transition-colors group-hover:text-primary">{block.label}</span>
                  </span>
                </a>
              );
            }
            if (block.type === "pullquote") {
              return (
                <figure class="my-8 rounded-2xl border border-primary/20 bg-secondary/50 p-7 md:p-8">
                  <blockquote class="text-[17px] text-foreground md:text-[19px]" style="line-height: 1.6;">
                    &ldquo;{block.text}&rdquo;
                  </blockquote>
                  <figcaption class="mt-5 flex items-center gap-3">
                    {block.author === "Darren Camas" ? (
                      <img src="/brand/darren-camas.jpg" alt={block.author} width="44" height="44" loading="lazy" decoding="async" class="h-11 w-11 shrink-0 rounded-full border-2 border-primary/40 object-cover" />
                    ) : (
                      <span class="h-8 w-1 rounded-full bg-primary" aria-hidden="true"></span>
                    )}
                    <span class="flex flex-col">
                      <span class="text-[14px] font-semibold text-foreground">{block.author}</span>
                      {block.title && <span class="text-[13px] text-muted-foreground">{block.title}</span>}
                    </span>
                  </figcaption>
                </figure>
              );
            }
            if (block.type === "tweet") {
              const t = block.tweet;
              const statusUrl = t.id
                ? `https://twitter.com/${t.handle}/status/${t.id}`
                : t.url ?? `https://x.com/${t.handle}`;
              // Official X embed. widgets.js (loaded once at page end) upgrades
              // this blockquote into the live tweet. The inner markup is the
              // pre-render / no-JS fallback.
              return (
                <figure class="my-8 flex justify-center">
                  <blockquote
                    class="twitter-tweet"
                    data-dnt="true"
                    data-align="center"
                    style="max-width:550px;width:100%"
                  >
                    <p>{t.text}</p>
                    <a href={statusUrl}>{t.author} (@{t.handle}) on X</a>
                  </blockquote>
                </figure>
              );
            }
            return null;
          })}
        </div>

        {article.originalUrl && (
          <p class="mt-10 border-t border-border pt-5 text-[13px] text-muted-foreground">
            Originally posted by {author.name} on{" "}
            <a href={article.originalUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">X</a>.
          </p>
        )}
      </article>
    </div>

    <!-- More news -->
    {more.length > 0 && (
      <section class="border-t border-border bg-muted py-14 md:py-20">
        <div class="mx-auto max-w-[1200px] px-6">
          <div class="mb-8 flex items-end justify-between">
            <h2 class="text-foreground" style="font-size: clamp(22px, 4vw, 32px); line-height: 1.2;">More from the ecosystem</h2>
            <a href="/news" class="text-[14px] font-medium text-primary hover:underline">View all</a>
          </div>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {more.map((a) => (
              <ArticleCard article={a} />
            ))}
          </div>
        </div>
      </section>
    )}
  </div>
  <Footer />
  <CookieBanner />
</BaseLayout>

<script>
  document.querySelectorAll("[data-copy-link]").forEach((el) => {
    el.addEventListener("click", async () => {
      const url = el.getAttribute("data-url") || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        const original = el.getAttribute("aria-label");
        el.setAttribute("aria-label", "Link copied");
        el.classList.add("text-primary", "border-primary/40");
        setTimeout(() => {
          el.setAttribute("aria-label", original || "Copy link");
          el.classList.remove("text-primary", "border-primary/40");
        }, 1500);
      } catch {
        /* clipboard unavailable — no-op */
      }
    });
  });
</script>

<script>
  // Load X's official embed widget once, matched to the current theme, only
  // when the article actually contains an embedded tweet.
  (function () {
    const tweets = document.querySelectorAll("blockquote.twitter-tweet");
    if (!tweets.length) return;
    const dark = document.documentElement.classList.contains("dark");
    tweets.forEach((el) =>
      el.setAttribute("data-theme", dark ? "dark" : "light"),
    );
    const s = document.createElement("script");
    s.src = "https://platform.twitter.com/widgets.js";
    s.async = true;
    document.head.appendChild(s);
  })();
</script>
