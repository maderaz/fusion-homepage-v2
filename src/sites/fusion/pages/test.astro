---
import BaseLayout from "@/shared/layouts/base-layout.astro";
// Fusion UI Kit (vendored design spec). The dashboard chrome (dark surfaces,
// panels, header) wraps the kit's .uk-c-* Manage Vaults components.
import "../styles/fusion-ui.css";

const buildNav = [
  { label: "Vault Wizard", icon: "sparkles" },
  { label: "Custom Vault", icon: "plus" },
  { label: "Vault Wrapper", icon: "plus" },
  { label: "Price Feed", icon: "plus" },
  { label: "My Fusion Vaults", icon: "grid", state: "selected" },
];
const manageSub = [
  "General Settings", "Access Manager", "Integrations", "Scheduled Ops",
  "Withdrawals", "Fees", "Price Oracle", "Prehooks",
];

type Vault = { asset: string; name: string; strategy: string; roles: string[] };
const groups: { chain: string; vaults: Vault[] }[] = [
  {
    chain: "Ethereum",
    vaults: [
      { asset: "stETH", name: "IPOR stETH Ethereum", strategy: "Leveraged Looping", roles: ["Owner", "Atomist", "Fuse Manager"] },
      { asset: "USDC", name: "IPOR USDC Prime", strategy: "Lending Optimizer", roles: ["Owner"] },
    ],
  },
  {
    chain: "Arbitrum",
    vaults: [
      { asset: "USDC", name: "Test Vault 1", strategy: "Leveraged Looping", roles: ["Owner"] },
      { asset: "ETH", name: "Test Vault 2", strategy: "Leveraged Looping", roles: ["Owner", "Atomist", "Alpha"] },
      { asset: "USDC", name: "Test Vault 3", strategy: "Lending Optimizer", roles: ["Owner", "Atomist", "Alpha", "Fuse Manager", "PreHooks Manager"] },
    ],
  },
];

const ethDiamond = `<svg viewBox="0 0 32 32" style="width:100%;height:100%"><circle cx="16" cy="16" r="16" fill="#627EEA"/><g fill="#fff"><path d="M16 5v8.1l6.8 3z" fill-opacity=".7"/><path d="M16 5 9.2 16.1l6.8-3z"/><path d="M16 21.5v5.4l6.8-9.4z" fill-opacity=".7"/><path d="M16 26.9v-5.4l-6.8-4z"/><path d="M16 20.2l6.8-4L16 13.2z" fill-opacity=".4"/><path d="M9.2 16.2l6.8 4v-7z"/></g></svg>`;
const tokenIcon: Record<string, string> = {
  USDC: `<svg viewBox="0 0 32 32" style="width:100%;height:100%"><circle cx="16" cy="16" r="16" fill="#2775CA"/><path d="M16 6.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19zm2.6 12.9c0 1.5-1.1 2.4-2.9 2.6v1.3h-1.1V22c-1.7-.2-2.8-1.2-2.9-2.6h1.3c.1.8.7 1.3 1.6 1.5v-3l-.5-.1c-1.5-.4-2.3-1.1-2.3-2.4 0-1.4 1-2.3 2.8-2.5V11.6h1.1v1.3c1.5.2 2.5 1.1 2.6 2.4h-1.3c-.1-.7-.5-1.2-1.3-1.4v2.8l.6.1c1.6.4 2.7 1.1 2.7 2.6z" fill="#fff"/></svg>`,
  stETH: `<svg viewBox="0 0 32 32" style="width:100%;height:100%"><circle cx="16" cy="16" r="16" fill="#00A3FF"/><g fill="#fff"><path d="M16 6l4.6 7.3L16 15.9l-4.6-2.6z" fill-opacity=".85"/><path d="M16 17.4l4.6-2.6-4.6 7-4.6-7z"/></g></svg>`,
  ETH: ethDiamond,
};
const chainIcon: Record<string, string> = {
  Ethereum: `<svg viewBox="0 0 32 32" style="width:100%;height:100%"><circle cx="16" cy="16" r="16" fill="#25292E"/><g fill="#fff"><path d="M16 6v7.4l6.2 2.8z" fill-opacity=".6"/><path d="M16 6 9.8 16.2l6.2-2.8zM16 20.6V27l6.3-8.7z" fill-opacity=".6"/><path d="M16 27v-6.4l-6.2-3.6z"/></g></svg>`,
  Arbitrum: `<svg viewBox="0 0 32 32" style="width:100%;height:100%"><circle cx="16" cy="16" r="16" fill="#213147"/><path d="M16 7l6.5 11.3-2.6 1.5L16 12.2l-3.9 7.6-2.6-1.5z" fill="#fff"/><path d="M18.2 20.6 16 24.8l-2.2-4.2 2.2-4z" fill="#2D9CDB"/></svg>`,
};
---

<BaseLayout title="Fusion Terminal — My Fusion Vaults" description="Fusion Terminal vault management dashboard.">
  <div class="term">
    <!-- Sidebar -->
    <aside class="term-side">
      <div class="term-logo">
        <span class="term-logo-mark">
          <svg width="26" height="26" viewBox="0 0 38 38" fill="#8429FF"><path d="M38 19c0-3.95-4.03-7.3-10.06-8.98C26.34 4.03 22.99 0 19.04 0S11.74 4.03 10.06 10.06C4.03 11.75 0 15.1 0 19.04s4.03 7.3 10.06 8.99C11.75 34.06 15.1 38.09 19.04 38.09s7.3-4.03 8.98-10.06C34.06 26.34 38 22.99 38 19.04zM19.04 11.59c2.27-.01 4.54.23 6.76.7.47 2.22.7 4.47.69 6.74.01 1.73-.13 3.45-.4 5.16L13.88 11.98c1.71-.27 3.44-.4 5.16-.39zm-7.46 7.44c0-1.73.13-3.44.4-5.15l12.22 12.22c-1.71.27-3.44.4-5.16.4-2.27 0-4.54-.24-6.76-.7-.47-2.23-.7-4.47-.7-6.77z"></path></svg>
        </span>
        <span class="term-logo-txt"><b>Fusion</b><i>Terminal</i></span>
      </div>

      <nav class="term-nav">
        <p class="term-group">Build on Fusion</p>
        {buildNav.map((item) => (
          <button class="uk-c-menu-item" data-state={item.state}>
            <svg class="uk-menuicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              {item.icon === "sparkles" && <path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9zM19 3v4M21 5h-4" />}
              {item.icon === "plus" && <><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></>}
              {item.icon === "grid" && <><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></>}
            </svg>
            {item.label}
          </button>
        ))}

        <p class="term-group">Manage Vaults</p>
        <button class="uk-c-vault-select">
          <span class="uk-vs-ph">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.7-2.5 2-2.5 3.5M12 17h.01" /></svg>
          </span>
          <span class="uk-vs-label">Select Vault</span>
        </button>
        <div class="term-sub">
          {manageSub.map((label) => (
            <button class="uk-c-menu-item" data-state="disabled">
              <svg class="uk-menuicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3" /></svg>
              {label}
            </button>
          ))}
        </div>

        <p class="term-group">Resources</p>
        <button class="uk-c-menu-item">
          <svg class="uk-menuicon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h13v18H6a2 2 0 0 1-2-2z" /><path d="M8 3v18" /></svg>
          Fusion Docs
        </button>
      </nav>
    </aside>

    <!-- Main -->
    <main class="term-main">
      <div class="term-head">
        <h1 class="term-title">My Fusion Vaults</h1>
        <div class="term-wallet">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8429FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h13a1 1 0 0 1 1 1v2" /><path d="M3 7v10a2 2 0 0 0 2 2h14a1 1 0 0 0 1-1v-3" /><path d="M16 12h5v4h-5a2 2 0 0 1 0-4z" /></svg>
          xyz0cz…EfEc
        </div>
      </div>

      <div class="uk-c-search term-search" data-state="default">
        <svg class="uk-search-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" /></svg>
        <span class="uk-search-text ph">Search vaults</span>
      </div>

      {groups.map((group) => (
        <section class="term-panel">
          <div class="term-panel-head">
            <span class="term-chain" set:html={chainIcon[group.chain]} />
            <h2 class="term-chain-name">{group.chain}</h2>
            <span class="term-chip">{group.vaults.length} vaults</span>
          </div>

          <div class="term-tablewrap">
            <table class="term-table">
              <thead>
                <tr class="term-thead">
                  <th>Chain / Asset</th>
                  <th>Vault Name / Strategy</th>
                  <th>My Role</th>
                  <th>View</th>
                  <th class="term-th-right">Manage Vault</th>
                </tr>
              </thead>
              <tbody>
                {group.vaults.map((v) => (
                  <tr class="uk-c-vault-row">
                    <td>
                      <span class="term-asset">
                        <span class="uk-vault-img" set:html={tokenIcon[v.asset] ?? ethDiamond} />
                        <span class="term-asset-chain" set:html={chainIcon[group.chain]} />
                      </span>
                    </td>
                    <td>
                      <div class="term-vname">{v.name}</div>
                      <div class="term-vstrat">{v.strategy}</div>
                    </td>
                    <td>
                      <div class="term-roles">
                        {v.roles.map((role) => (
                          <span class="uk-c-role">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" /></svg>
                            {role}
                          </span>
                        ))}
                      </div>
                    </td>
                    <td>
                      <a class="uk-c-extlink" href="#" aria-label="View vault">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" /></svg>
                      </a>
                    </td>
                    <td class="term-td-right">
                      <button class="uk-c-manage-btn" type="button">Manage</button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </main>
  </div>
</BaseLayout>

<style>
  .term {
    display: flex;
    min-height: 100vh;
    background: #090c10;
    color: #fff;
    font-family: var(--uk-font);
  }
  /* Sidebar */
  .term-side {
    width: 272px;
    flex: none;
    border-right: 1px solid #1c2026;
    padding: 20px 12px;
    display: none;
  }
  @media (min-width: 1024px) { .term-side { display: block; } }
  .term-logo { display: flex; align-items: center; gap: 10px; padding: 4px 8px 18px; }
  .term-logo-mark { display: inline-flex; }
  .term-logo-txt { display: flex; flex-direction: column; line-height: 1.05; }
  .term-logo-txt b { font-weight: 600; font-size: 18px; }
  .term-logo-txt i { font-style: normal; font-size: 12px; color: var(--uk-text-muted); }
  .term-nav { display: flex; flex-direction: column; }
  .term-nav .uk-c-menu-item { width: 100%; }
  .term-group {
    font-size: 11px; text-transform: uppercase; letter-spacing: .07em;
    color: #5b6270; padding: 0 9px; margin: 20px 0 8px;
  }
  .term-sub { margin-left: 10px; padding-left: 8px; border-left: 1px solid #1c2026; }
  .term-sub .uk-c-menu-item { height: 34px; font-size: 14px; }

  /* Main */
  .term-main { flex: 1; min-width: 0; padding: 26px 28px 60px; }
  .term-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
  .term-title { font-size: 22px; font-weight: 600; }
  .term-wallet {
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid #2a2f37; border-radius: 999px; background: #0e1217;
    padding: 9px 16px; font-size: 14px; color: #e6e8ec;
  }
  .term-search { margin-bottom: 22px; }

  /* Panels */
  .term-panel { border: 1px solid #1c2026; background: #0d1117; border-radius: 16px; margin-bottom: 22px; }
  .term-panel-head { display: flex; align-items: center; gap: 10px; padding: 18px 20px 12px; }
  .term-chain { width: 26px; height: 26px; display: inline-flex; }
  .term-chain-name { font-size: 16px; font-weight: 600; }
  .term-chip { background: #22272c; color: var(--uk-text-muted); border-radius: 999px; padding: 3px 10px; font-size: 12px; }

  .term-tablewrap { overflow-x: auto; }
  .term-table { width: 100%; min-width: 760px; border-collapse: collapse; }
  .term-thead th {
    text-align: left; font-weight: 500; font-size: 11px; text-transform: uppercase; letter-spacing: .05em;
    color: #5b6270; padding: 6px 18px 12px;
  }
  .term-th-right, .term-td-right { text-align: right; }

  .term-asset { position: relative; display: inline-flex; }
  .term-asset .uk-vault-img { background: #0e1217; }
  .term-asset-chain {
    position: absolute; right: -4px; bottom: -4px; width: 16px; height: 16px;
    border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 2px #0d1117;
  }
  .term-vname { font-size: 15px; font-weight: 500; color: #fff; }
  .term-vstrat { font-size: 13px; color: var(--uk-text-muted); margin-top: 2px; }
  .term-roles { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
