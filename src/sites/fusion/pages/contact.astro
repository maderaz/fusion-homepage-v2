---
import BaseLayout from "@/shared/layouts/base-layout.astro";
import Nav from "../components/nav.astro";
import Footer from "@/shared/components/footer.astro";
import CookieBanner from "@/shared/components/cookie-banner.astro";

// Form submissions are emailed via FormSubmit (no backend on a static site).
// Recipient is a test address for now.
const FORM_ENDPOINT = "https://formsubmit.co/z@ipor.io";
const nextUrl = new URL("/contact?sent=1", Astro.site).toString();

const orgTypes = [
  "Asset Manager", "Crypto Platform", "Onchain Protocol", "Family Office",
  "Fintech", "Institutional Investor", "Investment Fund", "Press",
  "Regulator", "VC", "Other",
];
const interests = [
  "Launching a vault",
  "Accessing offchain optimization algorithm",
  "General / Other Conversation",
];

const inputCls =
  "w-full rounded-xl border border-border bg-secondary/40 px-4 py-3 text-[15px] text-foreground outline-none transition-colors placeholder:text-muted-foreground focus:border-primary/60 focus:bg-secondary/60";
const labelCls = "mb-2 block text-[14px] text-muted-foreground";
// Custom dropdown (replaces native <select> so the menu + chevron match the
// site rather than the OS). The chevron sits inside the px-4 padding so it
// never touches the right edge.
const triggerCls =
  "flex w-full items-center justify-between gap-3 rounded-xl border border-border bg-secondary/40 px-4 py-3 text-left text-[15px] outline-none transition-colors hover:bg-secondary/60 focus:border-primary/60 focus:bg-secondary/60";
const csMenuCls =
  "cs-menu absolute left-0 right-0 top-[calc(100%+6px)] z-20 hidden max-h-60 overflow-auto rounded-xl border border-border bg-card p-1 shadow-xl";
const csOptionCls =
  "cs-option cursor-pointer rounded-lg px-3 py-2.5 text-[15px] text-foreground transition-colors hover:bg-secondary";

const selects = [
  { id: "orgType", name: "Organization type", label: "Organization type", options: orgTypes },
  { id: "interest", name: "Interested in", label: "What product/service are you interested in?", options: interests },
];
---

<BaseLayout
  title="Contact | Fusion by IPOR"
  description="Get in touch with the Fusion team — launch a vault, access offchain optimization, or start a conversation."
>
  <Nav />
  <div class="min-h-screen bg-background">
    <main class="mx-auto grid max-w-[1120px] grid-cols-1 gap-12 px-6 pt-32 pb-24 md:grid-cols-2 md:gap-16 md:pt-40">
      <!-- Left -->
      <div class="md:pt-4">
        <h1 class="text-foreground" style="font-size: clamp(34px, 6vw, 56px); line-height: 1.05;">
          Contact us
        </h1>
        <p class="mt-6 max-w-md text-[16px] text-muted-foreground" style="line-height: 1.7;">
          Whether you want to launch a vault, tap into Fusion's offchain
          optimization, or explore a partnership, tell us a bit about you and
          the team will get back to you.
        </p>

        <hr class="mt-8 max-w-md border-border" />

        <p class="mt-6 text-[12px] font-medium uppercase tracking-[0.14em] text-foreground">
          About Fusion
        </p>
        <p class="mt-3 max-w-md text-[13px] text-muted-foreground" style="line-height: 1.75;">
          Developed by IPOR Labs AG (Zug, Switzerland), Fusion is the onchain
          vault infrastructure for institutional-grade yield strategies. Its
          compliance-friendly vault stack is accessed by leading curators and
          regulated institutions, including Fortune 500 custodian BitGo (NYSE:
          BTGO) and leading ETP issuer 21Shares, with vault isolation and
          verifiable, deterministic risk controls.
        </p>

        <div class="mt-8 max-w-md rounded-2xl bg-primary p-6 text-white sm:p-7">
          <p class="text-[12px] font-medium uppercase tracking-[0.14em] text-white/70">
            Registered office
          </p>
          <address class="mt-3 text-[14px] not-italic text-white/90" style="line-height: 1.8;">
            c/o AbaFin Treuhand AG, Baarerstrasse 82<br />
            <span class="inline-flex items-center gap-2">
              Zug, Switzerland 6302
              <svg viewBox="0 0 32 32" width="15" height="15" class="inline-block shrink-0 rounded-[3px] ring-1 ring-white/20" role="img" aria-label="Switzerland">
                <rect width="32" height="32" fill="#DA291C"></rect>
                <rect x="13" y="6" width="6" height="20" fill="#fff"></rect>
                <rect x="6" y="13" width="20" height="6" fill="#fff"></rect>
              </svg>
            </span>
          </address>
        </div>

        <!-- Community icons (mirrors the footer socials). -->
        <div class="mt-6 flex items-center gap-3">
          <a
            href="https://x.com/ipor_io"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Fusion on X"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-primary/60 hover:text-foreground"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817-5.966 6.817H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
          </a>
          <a
            href="https://www.linkedin.com/company/73049136/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Fusion on LinkedIn"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-primary/60 hover:text-foreground"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
          </a>
          <a
            href="https://discord.com/invite/bSKzq6UMJ3"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Fusion on Discord"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-primary/60 hover:text-foreground"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.21 0 2.176 1.094 2.157 2.418 0 1.334-.956 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.21 0 2.176 1.094 2.157 2.418 0 1.334-.946 2.419-2.157 2.419z"></path></svg>
          </a>
        </div>
      </div>

      <!-- Right -->
      <div>
        <!-- Success banner (shown after redirect) -->
        <div id="contact-success" class="hidden rounded-2xl border border-primary/30 bg-secondary/50 p-6">
          <h2 class="text-[20px] font-medium text-foreground">Thanks, we got it.</h2>
          <p class="mt-2 text-[15px] text-muted-foreground">
            Your message is on its way to the Fusion team. We'll be in touch shortly.
          </p>
          <a href="/" class="mt-5 inline-flex text-[14px] font-medium text-primary hover:underline">Back to home</a>
        </div>

        <form
          id="contact-form"
          action={FORM_ENDPOINT}
          method="POST"
          class="flex flex-col gap-6"
        >
          <!-- FormSubmit config -->
          <input type="hidden" name="_subject" value="New Fusion contact form submission" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value={nextUrl} />
          <!-- honeypot -->
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />

          <div>
            <label class={labelCls} for="name">Name<span class="text-primary">*</span></label>
            <input class={inputCls} id="name" name="Name" type="text" required autocomplete="name" />
          </div>

          <div>
            <label class={labelCls} for="email">Email<span class="text-primary">*</span></label>
            <input class={inputCls} id="email" name="Email" type="email" required autocomplete="email" />
          </div>

          <div>
            <label class={labelCls} for="org">Organization name<span class="text-primary">*</span></label>
            <input class={inputCls} id="org" name="Organization name" type="text" required autocomplete="organization" />
          </div>

          {selects.map((s) => (
            <div>
              <label class={labelCls} for={`${s.id}-trigger`}>{s.label}<span class="text-primary">*</span></label>
              <div class="custom-select relative" data-required="true">
                <input type="hidden" name={s.name} value="" />
                <button
                  type="button"
                  id={`${s.id}-trigger`}
                  class={triggerCls}
                  aria-haspopup="listbox"
                  aria-expanded="false"
                >
                  <span class="cs-label text-muted-foreground">Please Select</span>
                  <svg
                    class="cs-chevron size-4 shrink-0 text-muted-foreground transition-transform duration-200"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </button>
                <ul class={csMenuCls} role="listbox" aria-label={s.label}>
                  {s.options.map((o) => (
                    <li class={csOptionCls} role="option" data-value={o}>{o}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))}

          <div>
            <label class={labelCls} for="message">Message</label>
            <textarea class={`${inputCls} min-h-[120px] resize-y`} id="message" name="Message" rows="4"></textarea>
          </div>

          <button
            type="submit"
            class="brand-gradient inline-flex w-full items-center justify-center rounded-full border border-primary px-6 py-3 text-[15px] font-semibold text-white transition-opacity duration-300 hover:opacity-80 sm:w-auto"
          >
            Send message
          </button>
        </form>
      </div>
    </main>
  </div>
  <Footer />
  <CookieBanner />
</BaseLayout>

<script>
  // ---- Custom dropdowns -------------------------------------------------
  interface CS {
    root: HTMLElement;
    hidden: HTMLInputElement;
    trigger: HTMLButtonElement;
    close: () => void;
  }

  function initSelect(root: HTMLElement): CS {
    const trigger = root.querySelector<HTMLButtonElement>("button")!;
    const label = root.querySelector<HTMLElement>(".cs-label")!;
    const chevron = root.querySelector<SVGElement>(".cs-chevron")!;
    const menu = root.querySelector<HTMLElement>(".cs-menu")!;
    const hidden = root.querySelector<HTMLInputElement>("input[type=hidden]")!;
    const options = root.querySelectorAll<HTMLElement>(".cs-option");

    const open = () => {
      menu.classList.remove("hidden");
      trigger.setAttribute("aria-expanded", "true");
      chevron.classList.add("rotate-180");
    };
    const close = () => {
      menu.classList.add("hidden");
      trigger.setAttribute("aria-expanded", "false");
      chevron.classList.remove("rotate-180");
    };

    trigger.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      closeAll();
      if (!isOpen) open();
    });

    options.forEach((opt) => {
      opt.addEventListener("click", () => {
        const val = opt.getAttribute("data-value") ?? "";
        hidden.value = val;
        label.textContent = val;
        label.classList.remove("text-muted-foreground");
        label.classList.add("text-foreground");
        options.forEach((o) => o.classList.remove("text-primary", "font-medium"));
        opt.classList.add("text-primary", "font-medium");
        trigger.classList.remove("border-red-500/70");
        close();
      });
    });

    return { root, hidden, trigger, close };
  }

  const selects: CS[] = Array.from(
    document.querySelectorAll<HTMLElement>(".custom-select"),
  ).map(initSelect);

  function closeAll() {
    selects.forEach((s) => s.close());
  }
  document.addEventListener("click", closeAll);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });

  // ---- Required validation (hidden inputs aren't natively validated) ----
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    let firstInvalid: CS | null = null;
    selects.forEach((s) => {
      if (s.root.dataset.required && !s.hidden.value) {
        s.trigger.classList.add("border-red-500/70");
        if (!firstInvalid) firstInvalid = s;
      }
    });
    if (firstInvalid) {
      e.preventDefault();
      const target = firstInvalid as CS;
      target.trigger.focus();
      target.root.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  });

  // ---- Success state on redirect ----------------------------------------
  if (new URLSearchParams(window.location.search).get("sent") === "1") {
    document.getElementById("contact-form")?.classList.add("hidden");
    const ok = document.getElementById("contact-success");
    ok?.classList.remove("hidden");
    ok?.scrollIntoView({ behavior: "smooth", block: "center" });
  }
</script>
