---
import type { Article } from "../data/articles";
import { formatDate } from "../data/articles";

interface Props {
  article: Article;
  featured?: boolean;
}

const { article, featured = false } = Astro.props;
const href = `/news/${article.slug}`;
---

<a
  href={href}
  class:list={[
    "group relative flex overflow-hidden rounded-2xl border border-border bg-card transition-all duration-300 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5",
    featured
      ? "flex-col p-6 md:flex-row md:items-center md:gap-8 md:p-8"
      : "flex-col p-6 md:p-7",
  ]}
>
  {article.coverImage && (
    <img
      src={article.coverImage}
      alt={article.title}
      width="1200"
      height="480"
      loading="lazy"
      decoding="async"
      class:list={[
        "rounded-xl border border-border object-cover",
        featured
          ? "mb-5 aspect-[5/2] w-full md:mb-0 md:w-[54%]"
          : "mb-5 aspect-[5/2] w-full",
      ]}
    />
  )}

  <div class:list={["flex min-w-0 flex-col", featured && "md:justify-center"]}>
    <!-- Meta row -->
    <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
      <span
        class="inline-flex items-center rounded-full bg-secondary px-3 py-1 text-[11px] font-medium uppercase tracking-wide text-secondary-foreground"
      >
        {article.category}
      </span>
      <time datetime={article.date} class="text-[13px] text-muted-foreground">
        {formatDate(article.date)}
      </time>
      <span class="text-[13px] text-muted-foreground/60">
        &middot; {article.readingMinutes} min read
      </span>
    </div>

    <!-- Title -->
    <h3
      class:list={[
        "text-balance font-medium text-foreground transition-colors group-hover:text-primary",
        featured
          ? "text-[22px] leading-snug md:text-[30px]"
          : "text-lg leading-snug md:text-xl",
      ]}
    >
      {article.title}
    </h3>

    <!-- Excerpt -->
    <p
      class:list={[
        "mt-3 text-body-foreground",
        featured ? "text-[15px] md:text-base" : "text-[14px]",
      ]}
      style="line-height: 1.7;"
    >
      {article.excerpt}
    </p>
  </div>
</a>
