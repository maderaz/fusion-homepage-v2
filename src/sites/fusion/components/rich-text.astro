---
/**
 * Renders a single line of lightweight inline markup used in article body
 * text: `**bold**`, `[label](url)` links, bare URLs, @mentions and #hashtags.
 * Everything else is emitted as plain text. Kept deliberately small — this is
 * not a full Markdown parser, just enough for the announcement-style prose.
 */
type Run =
  | { t: "text"; v: string }
  | { t: "bold"; v: string }
  | { t: "link"; v: string; href: string };

interface Props {
  text: string;
}

const { text } = Astro.props;

// Display real entity names in prose instead of raw @handles, while still
// linking to the X profile. Keys are lowercased handles (without the @).
const HANDLES: Record<string, string> = {
  ipor_io: "IPOR Labs",
  bitgo: "BitGo",
  tesseractcrypto: "Tesseract",
  "21shares": "21Shares",
  aave: "Aave",
  base: "Base",
  coinbase: "Coinbase",
  merkl_xyz: "Merkl",
  opencover: "OpenCover",
  nexusmutual: "Nexus Mutual",
  sentinel_codes: "Sentinel",
  liquityprotocol: "Liquity",
  darrencamas: "Darren Camas",
  stephdan_law: "Stéphane Daniel",
  anchorage: "Anchorage",
  blockanalitica: "BlockAnalitica",
  bprotocoleth: "bprotocol",
  flowdesk_co: "Flowdesk",
  galaxyhq: "Galaxy",
  gauntlet_xyz: "Gauntlet",
  hyperithm: "Hyperithm",
  k3_capital: "K3 Capital",
  kpk_io: "KPK",
  llamarisk: "LlamaRisk",
  rockaway_x: "Rockaway",
  sentorahq: "Sentora",
  steakhousefi: "Steakhouse",
  keyrock: "Keyrock",
  "628labs": "TAU Labs",
};

// Order: markdown link, bold, @mention/#hashtag (not when preceded by a word
// char or dot, so emails like name@host.tld are left alone), bare URL.
const TOKEN =
  /\[([^\]]+)\]\(([^)\s]+)\)|\*\*([^*]+)\*\*|(?<![\w.])([@#][A-Za-z0-9_]+)|(https?:\/\/[^\s)]+)/g;

function parse(input: string): Run[] {
  const runs: Run[] = [];
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = TOKEN.exec(input)) !== null) {
    if (m.index > last) runs.push({ t: "text", v: input.slice(last, m.index) });
    if (m[1] && m[2]) {
      runs.push({ t: "link", v: m[1], href: m[2] });
    } else if (m[3]) {
      runs.push({ t: "bold", v: m[3] });
    } else if (m[4]) {
      const tok = m[4];
      if (tok[0] === "#") {
        runs.push({
          t: "link",
          v: tok,
          href: `https://x.com/hashtag/${tok.slice(1)}`,
        });
      } else {
        const handle = tok.slice(1);
        runs.push({
          t: "link",
          v: HANDLES[handle.toLowerCase()] ?? tok,
          href: `https://x.com/${handle}`,
        });
      }
    } else {
      runs.push({ t: "link", v: m[5], href: m[5] });
    }
    last = m.index + m[0].length;
  }
  if (last < input.length) runs.push({ t: "text", v: input.slice(last) });
  return runs;
}

const runs = parse(text);
---

{
  runs.map((r) =>
    r.t === "text" ? (
      r.v
    ) : r.t === "bold" ? (
      <strong class="font-semibold text-foreground">{r.v}</strong>
    ) : (
      <a
        href={r.href}
        target="_blank"
        rel="noopener noreferrer"
        class="break-words text-primary underline-offset-2 hover:underline"
      >
        {r.v}
      </a>
    ),
  )
}
