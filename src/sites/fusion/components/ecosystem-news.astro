---
import { getArticles } from "../data/articles";
import ArticleCard from "./article-card.astro";

const articles = getArticles();
const featured = articles[0];
const rest = articles.slice(1, 3);
const hasRest = rest.length > 0;
---

{featured && (
  <section id="ecosystem-news" class="relative bg-background py-10 md:py-28">
    <div class="mx-auto max-w-[1200px] px-6">
      <!-- Header -->
      <div class="mb-10 flex flex-col gap-6 md:mb-14 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl">
          <p class="mb-4 text-[13px] font-medium uppercase tracking-wide text-primary">
            Ecosystem News
          </p>
          <h2
            class="mb-4 text-balance text-foreground"
            style="font-size: clamp(25px, 5vw, 45px); line-height: 1.15;"
          >
            The latest from the <span class="text-primary">Fusion</span> ecosystem.
          </h2>
          <p class="text-base text-muted-foreground sm:text-lg" style="line-height: 1.7;">
            Partnerships, integrations and milestones from the teams building
            institutional-grade onchain yield on Fusion.
          </p>
        </div>
        <a
          href="/news"
          class="group inline-flex shrink-0 items-center gap-1.5 self-start rounded-full border border-border px-5 py-2.5 text-[14px] font-medium text-foreground transition-all duration-300 hover:border-primary/40 hover:text-primary md:self-auto"
        >
          View all news
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Cards -->
      <div
        class:list={[
          "grid gap-6",
          hasRest ? "lg:grid-cols-2" : "grid-cols-1",
        ]}
      >
        <ArticleCard article={featured} featured={!hasRest} />
        {hasRest && (
          <div class="grid grid-cols-1 gap-6">
            {rest.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}
