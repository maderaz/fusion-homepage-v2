---
// Pure static template — zero client-side JavaScript
// SVG icons use SMIL animation (browser-native, no JS needed)
import { Image } from "astro:assets";
import vaultOverview from "@/shared/assets/vault-overview.png";
---

<section
  id="transparency"
  class="relative py-20 md:py-28"
>
  <div class="mx-auto max-w-[1200px] px-6">
    <!-- 50/50 layout -->
    <div class="flex flex-col gap-12 lg:flex-row lg:gap-10">
      <!-- Left: Vault overview dashboard -->
      <div class="flex w-full lg:w-1/2 items-center justify-center">
        <Image
          src={vaultOverview}
          alt="Fusion vault overview dashboard showing IPOR USDC Prime vault with performance reports, historical allocation, and credit markets"
          class="w-full max-w-[560px] rounded-2xl border border-border"
          width={560}
          loading="lazy"
          densities={[1, 2]}
        />
      </div>

      <!-- Right: header + features list -->
      <div class="w-full lg:w-1/2 flex flex-col justify-center">
        <!-- Section header -->
        <div class="mb-8">
          <div
            class="mb-4 text-[13px] font-medium uppercase tracking-wide text-primary"
          >
            Full Transparency
          </div>
          <h2
            class="mb-4 tracking-tight text-foreground"
            style="font-size: clamp(25px, 5vw, 45px); line-height: clamp(38px, 5vw, 60px);"
          >
            See everything.{" "}
            <span class="text-primary">Trust nothing blindly.</span>
          </h2>
          <p
            class="text-base text-muted-foreground"
            style="line-height: 1.7;"
          >
            Every vault in Fusion exposes its full mechanics: allocations,
            performance, costs, and onchain activity. You always know
            exactly what's happening with your capital.
          </p>
        </div>

        <!-- Feature boxes — icon + title only -->
        <div class="grid grid-cols-2 gap-3">
          <!-- Real-Time Performance Reports -->
          <div class="group flex flex-col items-center gap-2 rounded-xl border border-border bg-card px-3 py-4 text-center transition-all duration-300 hover:border-primary/30 hover:shadow-sm sm:flex-row sm:text-left sm:px-4 sm:py-3.5 sm:gap-3 overflow-hidden">
            <div class="flex shrink-0 items-center justify-center rounded-lg border-border bg-primary/10 p-2 dark:border dark:border-border dark:bg-primary/20">
              <!-- AnimatedBarChart -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <line x1="3" y1="20" x2="21" y2="20" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round"/>
                <rect x="6" width="3" rx="1" fill="#8429FF" opacity="0.8">
                  <animate attributeName="y" values="12;9;14;12" dur="4s" repeatCount="indefinite"/>
                  <animate attributeName="height" values="8;11;6;8" dur="4s" repeatCount="indefinite"/>
                </rect>
                <rect x="11" width="3" rx="1" fill="#8429FF" opacity="0.8">
                  <animate attributeName="y" values="8;12;6;10;8" dur="5s" repeatCount="indefinite"/>
                  <animate attributeName="height" values="12;8;14;10;12" dur="5s" repeatCount="indefinite"/>
                </rect>
                <rect x="16" width="3" rx="1" fill="#8429FF" opacity="0.8">
                  <animate attributeName="y" values="10;7;13;10" dur="4.5s" repeatCount="indefinite"/>
                  <animate attributeName="height" values="10;13;7;10" dur="4.5s" repeatCount="indefinite"/>
                </rect>
              </svg>
            </div>
            <h3 class="text-[12px] sm:text-[13px] font-medium min-w-0 break-words text-foreground">
              Real-Time Performance Reports
            </h3>
          </div>

          <!-- Historical Allocation Breakdown -->
          <div class="group flex flex-col items-center gap-2 rounded-xl border border-border bg-card px-3 py-4 text-center transition-all duration-300 hover:border-primary/30 hover:shadow-sm sm:flex-row sm:text-left sm:px-4 sm:py-3.5 sm:gap-3 overflow-hidden">
            <div class="flex shrink-0 items-center justify-center rounded-lg border-border bg-primary/10 p-2 dark:border dark:border-border dark:bg-primary/20">
              <!-- AnimatedPieChart -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="#8429FF" stroke-width="1.5" opacity="0.3"/>
                <path d="M12 3 A9 9 0 0 1 21 12 L12 12 Z" fill="#8429FF" opacity="0.2">
                  <animateTransform attributeName="transform" type="rotate" values="0 12 12;6 12 12;0 12 12" dur="14s" repeatCount="indefinite"/>
                </path>
                <path d="M12 3 A9 9 0 0 0 3 12 L12 12 Z" fill="#8429FF" opacity="0.4">
                  <animateTransform attributeName="transform" type="rotate" values="0 12 12;-5 12 12;0 12 12" dur="14s" repeatCount="indefinite"/>
                </path>
                <line x1="12" y1="12" x2="12" y2="3" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round">
                  <animateTransform attributeName="transform" type="rotate" values="0 12 12;3 12 12;0 12 12" dur="14s" repeatCount="indefinite"/>
                </line>
                <line x1="12" y1="12" x2="21" y2="12" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round">
                  <animateTransform attributeName="transform" type="rotate" values="0 12 12;3 12 12;0 12 12" dur="14s" repeatCount="indefinite"/>
                </line>
                <line x1="12" y1="12" x2="5" y2="19" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round">
                  <animateTransform attributeName="transform" type="rotate" values="0 12 12;-2 12 12;0 12 12" dur="14s" repeatCount="indefinite"/>
                </line>
              </svg>
            </div>
            <h3 class="text-[12px] sm:text-[13px] font-medium min-w-0 break-words text-foreground">
              Historical Allocation Breakdown
            </h3>
          </div>

          <!-- Protocol-Level Credit Markets -->
          <div class="group flex flex-col items-center gap-2 rounded-xl border border-border bg-card px-3 py-4 text-center transition-all duration-300 hover:border-primary/30 hover:shadow-sm sm:flex-row sm:text-left sm:px-4 sm:py-3.5 sm:gap-3 overflow-hidden">
            <div class="flex shrink-0 items-center justify-center rounded-lg border-border bg-primary/10 p-2 dark:border dark:border-border dark:bg-primary/20">
              <!-- AnimatedLayers -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M2 17l10 5 10-5" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.4">
                  <animate attributeName="d" values="M2 17l10 5 10-5;M2 18l10 4 10-4;M2 17l10 5 10-5" dur="6s" repeatCount="indefinite"/>
                </path>
                <path d="M2 12l10 5 10-5" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.7">
                  <animate attributeName="d" values="M2 12l10 5 10-5;M2 12l10 5 10-5;M2 12l10 5 10-5" dur="6s" repeatCount="indefinite"/>
                </path>
                <path d="M2 7l10 5 10-5" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="#8429FF" fill-opacity="0.1">
                  <animate attributeName="d" values="M2 7l10 5 10-5;M2 6l10 6 10-6;M2 7l10 5 10-5" dur="6s" repeatCount="indefinite"/>
                </path>
                <path d="M12 2L2 7l10 5 10-5z" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
                  <animate attributeName="d" values="M12 2L2 7l10 5 10-5z;M12 1L2 6l10 6 10-6z;M12 2L2 7l10 5 10-5z" dur="6s" repeatCount="indefinite"/>
                </path>
              </svg>
            </div>
            <h3 class="text-[12px] sm:text-[13px] font-medium min-w-0 break-words text-foreground">
              Protocol-Level Credit Markets
            </h3>
          </div>

          <!-- Live Yield Metrics -->
          <div class="group flex flex-col items-center gap-2 rounded-xl border border-border bg-card px-3 py-4 text-center transition-all duration-300 hover:border-primary/30 hover:shadow-sm sm:flex-row sm:text-left sm:px-4 sm:py-3.5 sm:gap-3 overflow-hidden">
            <div class="flex shrink-0 items-center justify-center rounded-lg border-border bg-primary/10 p-2 dark:border dark:border-border dark:bg-primary/20">
              <!-- AnimatedActivity -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M2 12h4l2-6 3 12 2-8 2 4h7" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.15"/>
                <path d="M2 12h4l2-6 3 12 2-8 2 4h7" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="60" stroke-dashoffset="0">
                  <animate attributeName="stroke-dashoffset" values="60;0;0;60" keyTimes="0;0.4;0.6;1" dur="2.5s" repeatCount="indefinite"/>
                  <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.2;0.7;1" dur="2.5s" repeatCount="indefinite"/>
                </path>
                <circle r="2" fill="#8429FF" opacity="0.8">
                  <animateMotion path="M2 12 L6 12 L8 6 L11 18 L13 10 L15 14 L22 14" dur="2.5s" repeatCount="indefinite"/>
                  <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.8;1" dur="2.5s" repeatCount="indefinite"/>
                </circle>
              </svg>
            </div>
            <h3 class="text-[12px] sm:text-[13px] font-medium min-w-0 break-words text-foreground">
              <span class="sm:hidden">Live<br/>Yield Metrics</span>
              <span class="hidden sm:inline">Live Yield Metrics</span>
            </h3>
          </div>

          <!-- Transaction-Level Auditability -->
          <div class="group flex flex-col items-center gap-2 rounded-xl border border-border bg-card px-3 py-4 text-center transition-all duration-300 hover:border-primary/30 hover:shadow-sm sm:flex-row sm:text-left sm:px-4 sm:py-3.5 sm:gap-3 overflow-hidden">
            <div class="flex shrink-0 items-center justify-center rounded-lg border-border bg-primary/10 p-2 dark:border dark:border-border dark:bg-primary/20">
              <!-- AnimatedEye -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="12" r="3.5" stroke="#8429FF" stroke-width="1.5" fill="#8429FF" fill-opacity="0.15"/>
                <circle r="1.8" fill="#8429FF" opacity="0.85">
                  <animate attributeName="cx" values="12;14;14;10;10;12;12" keyTimes="0;0.15;0.3;0.45;0.6;0.75;1" dur="4s" repeatCount="indefinite"/>
                  <animate attributeName="cy" values="12;11;13;13;11;12;12" keyTimes="0;0.15;0.3;0.45;0.6;0.75;1" dur="4s" repeatCount="indefinite"/>
                </circle>
                <path d="M2 12s3.5-7 10-7 10 7 10 7" stroke="none" fill="currentColor" class="text-card" opacity="0">
                  <animate attributeName="opacity" values="0;0;0;1;0;0" keyTimes="0;0.72;0.74;0.76;0.78;1" dur="4s" repeatCount="indefinite"/>
                </path>
                <line x1="2" y1="12" x2="22" y2="12" stroke="#8429FF" stroke-width="2" opacity="0">
                  <animate attributeName="opacity" values="0;0;0;1;0;0" keyTimes="0;0.72;0.74;0.76;0.78;1" dur="4s" repeatCount="indefinite"/>
                </line>
              </svg>
            </div>
            <h3 class="text-[12px] sm:text-[13px] font-medium min-w-0 break-words text-foreground">
              Transaction-Level Auditability
            </h3>
          </div>

          <!-- Cost & Slippage Transparency -->
          <div class="group flex flex-col items-center gap-2 rounded-xl border border-border bg-card px-3 py-4 text-center transition-all duration-300 hover:border-primary/30 hover:shadow-sm sm:flex-row sm:text-left sm:px-4 sm:py-3.5 sm:gap-3 overflow-hidden">
            <div class="flex shrink-0 items-center justify-center rounded-lg border-border bg-primary/10 p-2 dark:border dark:border-border dark:bg-primary/20">
              <!-- AnimatedShield -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2l8 4v5c0 5.25-3.5 9.74-8 11-4.5-1.26-8-5.75-8-11V6l8-4z" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="#8429FF" fill-opacity="0.08"/>
                <path d="M9 12l2 2 4-4" stroke="#8429FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="12">
                  <animate attributeName="stroke-dashoffset" values="12;0;0;0;12" keyTimes="0;0.25;0.6;0.8;1" dur="3.5s" repeatCount="indefinite"/>
                </path>
                <line x1="6" x2="18" stroke="#8429FF" stroke-width="1" opacity="0.4" stroke-linecap="round">
                  <animate attributeName="y1" values="4;20;4" dur="3.5s" repeatCount="indefinite"/>
                  <animate attributeName="y2" values="4;20;4" dur="3.5s" repeatCount="indefinite"/>
                  <animate attributeName="opacity" values="0;0.5;0.5;0" keyTimes="0;0.1;0.8;1" dur="3.5s" repeatCount="indefinite"/>
                </line>
              </svg>
            </div>
            <h3 class="text-[12px] sm:text-[13px] font-medium min-w-0 break-words text-foreground">
              Cost & Slippage Transparency
            </h3>
          </div>
        </div>
        <p class="mt-4 text-xs text-muted-foreground/60">
          *Product interface shown for illustrative purposes only. Displayed values are simulated and do not represent actual portfolio performance, balances, or guaranteed returns.
        </p>
      </div>
    </div>
  </div>
</section>
