---
import BaseHead from "@/shared/components/base-head.astro";
import ThemeScript from "@/shared/components/theme-script.astro";
import AnalyticsScript from "@/shared/components/analytics-script.astro";
import "@/shared/styles/index.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const { title, description, image, imageWidth, imageHeight, ogType, publishedTime, modifiedTime } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} imageWidth={imageWidth} imageHeight={imageHeight} ogType={ogType} publishedTime={publishedTime} modifiedTime={modifiedTime} />
    <ThemeScript />
    <AnalyticsScript />
  </head>
  <body>
    <slot />
  </body>
</html>
