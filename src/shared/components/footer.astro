---
import { footerColumns, legalLinks } from "@/shared/data/footer-links";

const headingCls = "mb-4 text-[13px] font-semibold text-white";
const linkCls = "text-[14px] text-white/55 transition-colors hover:text-white";
---

<!-- Solid dark footer band (always dark, regardless of page theme). -->
<footer class="bg-[#0B0F19] text-white">
  <div class="mx-auto max-w-[1200px] px-6 pt-16 pb-8 md:pt-20">
    <div class="flex flex-col gap-12 lg:flex-row lg:justify-between lg:gap-16">
      <!-- Brand block -->
      <div class="max-w-sm lg:w-[300px] lg:shrink-0">
        <img
          src="/brand/full-logo/fusion-full-logo-white-text.svg"
          alt="Fusion by IPOR"
          class="h-7 w-auto object-contain"
          loading="lazy"
          width="91"
          height="28"
        />
        <p class="mt-5 text-[14px] text-white/50" style="line-height: 1.7;">
          Onchain vault infrastructure for asset managers, institutions, and
          builders. Create, white-label and earn.
        </p>
        <!-- Socials -->
        <div class="mt-6 flex items-center gap-3">
          <a
            href="https://x.com/ipor_io"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Fusion on X"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-white/60 transition-colors hover:border-white/40 hover:text-white"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817-5.966 6.817H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
          </a>
          <a
            href="https://www.linkedin.com/company/73049136/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Fusion on LinkedIn"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-white/60 transition-colors hover:border-white/40 hover:text-white"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
          </a>
          <a
            href="https://discord.com/invite/bSKzq6UMJ3"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Fusion on Discord"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-white/60 transition-colors hover:border-white/40 hover:text-white"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.21 0 2.176 1.094 2.157 2.418 0 1.334-.956 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.21 0 2.176 1.094 2.157 2.418 0 1.334-.946 2.419-2.157 2.419z"></path></svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      <div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4 lg:gap-x-12">
        {footerColumns.map((column) => (
          <div class="flex flex-col gap-9">
            {column.map((group) => (
              <div>
                <p class={headingCls}>{group.title}</p>
                <ul class="flex flex-col gap-3">
                  {group.links.map((link) => (
                    <li>
                      {link.soon ? (
                        <span class="inline-flex items-center gap-2 text-[14px] text-white/30">
                          {link.label}
                          <span class="rounded bg-primary px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide text-white">
                            Soon
                          </span>
                        </span>
                      ) : (
                        <a
                          href={link.href}
                          target={link.href.startsWith("http") ? "_blank" : undefined}
                          rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                          class={linkCls}
                        >
                          {link.label}
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-7 sm:flex-row sm:items-center">
      <p class="text-[13px] text-white/45">
        &copy; 2026 IPOR Labs AG. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {legalLinks.map((link) => (
          <a href={link.href} class="text-[13px] text-white/55 transition-colors hover:text-white">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
